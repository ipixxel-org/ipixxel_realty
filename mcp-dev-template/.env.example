# Path to the OpenPage site JSON the tools edit by default.
OP_SITE_FILE=

# Backend base URL + org-user bearer token (required for the AI tools).
OP_API_BASE_URL=http://127.0.0.1:3000
OP_API_TOKEN=

# Where brand kits (theme + typography bundles) are saved.
# Defaults to ./.openpage/brand-kits relative to the working directory.
OP_BRAND_KIT_DIR=

# Transport: "stdio" (default) or "http".
OP_MCP_TRANSPORT=stdio
OP_MCP_PORT=7801
