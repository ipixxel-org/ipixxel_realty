# Copy this to .env and fill in real values before running docker-compose up

# Overridden by docker-compose.yml when running via Docker (points at the
# `postgres` service name instead of localhost) — this value is only used
# if you run the API outside Docker, directly on your machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bigestate?schema=public"

# Used by prisma/seed.ts to create the Super Admin account
SUPER_ADMIN_EMAIL="admin@bigestate.io"
SUPER_ADMIN_PASSWORD="changeme-before-first-deploy"

# JWT signing secret — generate a real one, don't ship this default
JWT_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3000

# Public frontend URL used in email login and password-reset links.
FRONTEND_URL="http://localhost:3001"

# S3-compatible object storage for media uploads — amenity icons, floor
# plans, brochures, walkthrough videos, gallery images. The bucket is
# public-read (marketing assets). Uploads go browser → storage via
# short-lived presigned PUT URLs issued by POST /org/projects/upload-url.
# Full S3-API endpoint URL. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# (swap for MinIO / Backblaze / another provider with no code change).
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_BUCKET_NAME="realestate-media"
# Public base URL for the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_URL="https://media.example.com"
# Team Chat attachments go to a SEPARATE bucket with NO public access (no
# r2.dev URL, no custom domain) and are only served via short-lived signed
# URLs. It has its OWN API token: the public R2_* credentials are never used
# for chat files, and these are never used for anything else. Required
# whenever R2 is configured — chat uploads return 503 if any of the three
# below is missing (no fallback to the public bucket). Bucket CORS must allow
# PUT/GET/HEAD from the app origin(s).

R2_PRIVATE_BUCKET_NAME="realestate-private"
R2_PRIVATE_ACCESS_KEY_ID="r2-private-access-key-id"
R2_PRIVATE_SECRET_ACCESS_KEY="r2-private-secret-access-key"

# Only if the private bucket lives in a different Cloudflare account; else
# R2_ENDPOINT's account is used. R2_PRIVATE_ENDPOINT (full URL) wins over it.

# R2_PRIVATE_ACCOUNT_ID=""
# R2_PRIVATE_ENDPOINT=""
# Max size of one chat attachment, in MB (default 100).
# TEAM_CHAT_MAX_ATTACHMENT_MB=100

# Team Chat real-time (Socket.IO namespace /team-chat on this API, path
# /socket.io). Browser origins allowed to open the socket, comma-separated;
# defaults to FRONTEND_URL. Must list the app host only (e.g.
# https://app.example.com) — never org custom domains. See
# docs/team-chat-realtime.md for the nginx /socket.io/ block.
# CHAT_WS_ORIGINS="http://localhost:3001"
# How long a user still shows "online" after their last tab closes (ms).
# TEAM_CHAT_PRESENCE_GRACE_MS=10000

# Facebook / Meta Lead Ads (platform app). Orgs OAuth-connect their Pages;
# NOTE: Credentials can be configured and saved directly from the Frontend UI
# (Connected Apps or Super Admin > Marketing). Values are stored securely in the
# database ("identity"."marketing_settings"). The .env values below are purely optional fallbacks.
# META_APP_ID=""
# META_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verify-token"
# Public API base Meta can reach (no trailing slash). Local tunnel e.g. ngrok.
# BACKEND_PUBLIC_URL="https://your-tunnel.example.com"

# Razorpay payments (Orders + Checkout).
# NOTE: Preferably configured from Super Admin > Integrations > Razorpay
# (stored in "billing"."razorpay_settings", applies without a restart; keys
# saved there override these). The .env values below are an optional fallback.
# Set all three or none: none = no env fallback; a partial or malformed set
# stops the API from booting. The webhook secret must be its own value — one
# equal to the (public) key id or the key secret is ignored.
# Keys: Razorpay Dashboard > Account & Settings > API Keys (test mode gives
# rzp_test_…). Webhook secret: the secret you type when adding the webhook
# {BACKEND_PUBLIC_URL}/webhooks/razorpay with events payment.captured,
# order.paid, payment.failed, refund.processed.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# Billing v2 — set together with the frontend's NEXT_PUBLIC_BILLING_V2=true.
# On the server it only changes what happens when grace ends unpaid: the org
# always falls back to the free plan (Basic), whatever the old "restrict" /
# "cancel" setting says. Leave unset while the old billing screens are live.
# BILLING_V2=true
# Testing aid, ignored when NODE_ENV=production: moves the billing clock
# (renewals, grace, fall back to Basic) without editing the database.
# A date ("2026-11-20"), a datetime, or an offset ("+10d", "-36h").
# BILLING_CLOCK_OVERRIDE="+10d"

# Google OAuth (Org Registration & Login) + Google Ads
# NOTE: Configured and managed directly from the Super Admin Console (Settings / API Credentials).
# Stored securely in database ("identity"."marketing_settings"). No .env variables required.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_ADS_CLIENT_ID=""
# GOOGLE_ADS_CLIENT_SECRET=""
# GOOGLE_ADS_DEVELOPER_TOKEN=""

# AI design agent for the OpenPage "AI Template" builder.
# The agent generates the ENTIRE page design (palette, typography, section
# composition, layout) from a prompt — nothing is hardcoded.
# AI_PROVIDER picks which agent is used: gemini | anthropic | external.
# Leave blank to auto-detect from whichever credential is present. When no
# provider is configured the AI endpoints return 503 (there is no static
# fallback design).
# AI_PROVIDER="gemini"

# Google Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
# 0 disables Gemini 2.5 "thinking" (faster/cheaper JSON generation).
# Only applies to Gemini 2.5 models; ignored for Gemini 3+.
# GEMINI_THINKING_BUDGET=0

# Anthropic Claude (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Any custom agent/hosted model that accepts POST { system, prompt } and
# returns a JSON design document (optionally wrapped in { site } / { data }).
# AI_GENERATE_API_URL=""
# AI_GENERATE_API_KEY=""

