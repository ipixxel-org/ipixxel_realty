model MarketingSyncLog {
  id           String   @id @default(uuid())
  orgId        String?  @map("org_id")
  connectionId String?  @map("connection_id")
  platformKey  String   @map("platform_key")
  direction    String   @default("inbound") // inbound | outbound
  status       String // success | failed
  message      String?
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  connection MarketingConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([platformKey])
  @@index([createdAt])
  @@index([status])
  @@map("marketing_sync_logs")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Per-org DISPLAY overrides for the fixed LeadStatus pipeline stages. This
// does NOT change Lead.status (still the enum above) or any logic keyed to
// its values — it only lets an org rename a stage and recolour its badge in
// the UI. One optional row per (org, status); a stage with no row falls back
// to the built-in default label/colour. The seven stages themselves are
// fixed — rows are never added, removed, or reordered.
// ---------------------------------------------------------------------------

model OrgLeadStageDisplay {
  id        String     @id @default(uuid())
  orgId     String     @map("org_id")
  status    LeadStatus
  label     String
  // Badge colour as a #RRGGBB hex string.
  color     String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, status])
  @@index([orgId])
  @@map("org_lead_stage_displays")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Call logs — phone activity per sales agent, for the Calls & comms tab on an
// agent's dashboard. leadName is denormalised (snapshot at call time) so the
// recent-calls table renders without a join; leadId is kept for drill-through.
// ---------------------------------------------------------------------------

enum CallDirection {
  outgoing
  incoming

  @@schema("templates")
}

model CallLog {
  id              String        @id @default(uuid())
  orgId           String        @map("org_id")
  agentId         String        @map("agent_id")
  leadId          String?       @map("lead_id")
  leadName        String?       @map("lead_name")
  direction       CallDirection @default(outgoing) @map("direction")
  outcome         String // connected | booked_visit | callback | no_answer | missed | busy
  durationSeconds Int           @default(0) @map("duration_seconds")
  createdAt       DateTime      @default(now()) @map("created_at")

  agent User? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([agentId])
  @@index([createdAt])
  @@map("call_logs")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Activity feed — the human-visible timeline on an agent's dashboard (deal
// closed, visit booked, call logged, message sent, stage changed, shift
// start). text is the ready-to-render line; type drives the icon/badging.
// ---------------------------------------------------------------------------

enum ActivityType {
  closed_deal
  site_visit_booked
  call_logged
  whatsapp_sent
  whatsapp_read
  note_added
  status_updated
  logged_in

  @@schema("templates")
}

model ActivityEvent {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  // Nullable: a null actor means the entry was produced by an automated
  // process (e.g. a public website-form capture) and renders as "System".
  // FK is SET NULL on user delete so history survives as System rather than
  // vanishing.
  agentId   String?      @map("agent_id")
  leadId    String?      @map("lead_id")
  type      ActivityType
  text      String
  createdAt DateTime     @default(now()) @map("created_at")

  agent User? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([agentId])
  @@index([createdAt])
  @@map("activity_events")
  @@schema("templates")
}

// projects — real-estate developments, their unit-type product mix, and the
// individual unit inventory beneath each type.
//   org 1─* projects 1─* unit_types 1─* units
// Every row is ultimately org-scoped: Project carries org_id directly;
// UnitType/Unit are scoped through their parent (the service always loads
// the owning Project by org_id first — see ProjectsService). No soft-delete
// anywhere, matching the rest of the codebase: deletes are hard deletes,
// paired with an audit_logs row.
// ---------------------------------------------------------------------------

enum ProjectStatus {
  active
  inactive

  @@schema("projects")
}

// Lifecycle of a captured lead in the CRM. Not driven by hard-coded casing
// order here — the allowed set only; stages are a presentation concern.
enum LeadStatus {
  new
  contacted
  follow_up
  site_visit
  negotiation
  won
  lost

  @@schema("templates")
}

enum UnitStatus {
  available
  booked
  held
  sold

  @@schema("projects")
}

// The org-managed catalogs the project onboarding wizard picks from. All are
// structurally identical (an org-scoped, orderable label), so one table keyed
// by this discriminator beats several near-identical tables — see
// OrgCatalogOption.
enum OrgCatalogCategory {
  project_type
  unit_type
  connectivity
  amenity
  // Step 3's "What's included in the price?" (multi-select) and "Payment plan
  // → Plan type" (single-select). Fixed frontend lists until they were brought
  // under the same org-managed catalog as the four above.
  price_includes
  payment_plan
  facing
  parking
  // The unit's optional variant label ("Type A", "Corner"). Was free text on
  // the unit form, confusingly labelled "Unit type" next to the actual unit
  // types — now an org-managed list like facing and parking.
  unit_variant
  // Lead option lists for the lead edit page, managed under Settings → CRM &
  // Leads. Only the categories with NO project equivalent live here —
  // Configuration reuses `unit_type`, and a lead's Facing / Parking reuse
  // `facing` / `parking` above (same value sets; one list per org, shared with
  // projects & units). `lead_tag` backs the lead's Tags multi-select.
  lead_purpose
  lead_financing
  lead_loan_status
  lead_timeline_to_buy
  lead_preferred_floor
  lead_tag

  @@schema("projects")
}

model Project {
  id                String        @id @default(uuid())
  orgId             String        @map("org_id")
  name              String
  location          String?
  reraId            String?       @map("rera_id")
  // Deliberately free text ("Dec 2027"), not a Date — see the build brief.
  possession        String?
  // FK to the org user who runs this project. Nullable — a project can be
  // unassigned. ON DELETE SET NULL: removing the user leaves the project.
  managerId         String?       @map("manager_id")
  status            ProjectStatus @default(active)
  priceMin          Int?          @map("price_min") // rupees
  priceMax          Int?          @map("price_max") // rupees
  baseRate          Int?          @map("base_rate") // rupees per sqft
  // No.-of-towers, floors/structure, area range and total land area used to
  // be fixed columns with hardcoded wizard inputs. They're now ordinary
  // (roleless) default `projectFields` template entries — same mechanism as
  // Specifications — so an org can rename, edit or delete them freely; no
  // schema-level concept of them remains.
  // Array of { name: string, iconUrl: string | null }. iconUrl is always
  // null for now — amenity-icon upload is out of scope (blocked on S3).
  amenities         Json          @default("[]")

  // --- Identity & timeline fields from wizard Steps 1-2. These were
  // collected by the create wizard from the start but had nowhere to land, so
  // they were silently dropped on publish and the edit page couldn't show
  // them. Added as plain optional columns so both pages round-trip them. ---
  // A `project_type` catalog label, copied at write time. Same "copy, don't
  // reference" rule as amenities/connectivity: no FK back to the catalog, so
  // renaming or deleting an option never rewrites an existing project.
  projectType       String?       @map("project_type")
  // Templates COPIED from the project type at creation (see ProjectTypeDef):
  // editing or deleting the type never changes this project. Which inventory
  // controls exist (grouping, floors, configurations, price) is derived at
  // read time from which ROLE fields (see common/utils/field-template.util.ts)
  // are present in `unitFieldTemplate` — there is no fixed layout. This
  // project's own editable copy of the templates; `customFields` are the
  // typed values for `projectFieldTemplate`, keyed by field key (values of
  // fields later removed from the template are kept, just hidden).
  // Soft pointer to the type it was created from — no FK, so deleting the
  // type is always safe. Used only to count a type's usage.
  projectTypeId        String?       @map("project_type_id")
  // Area unit every `area`-role figure and "₹ x / <unit>" price-per-area
  // display uses for this project. A plain string (not an enum) so more
  // units (sq yard, sq m) can be added later without a schema change.
  areaUnit             String        @default("sqft") @map("area_unit")
  projectFieldTemplate Json          @default("[]") @map("project_field_template")
  unitFieldTemplate    Json          @default("[]") @map("unit_field_template")
  customFields         Json          @default("{}") @map("custom_fields")
  tagline           String?
  // ISO "YYYY-MM-DD" exactly as an <input type="date"> produces it. Kept as
  // text on purpose: it's a plain calendar date with no time or zone, and a
  // DateTime would invite an off-by-one on the way in or out.
  launchDate        String?       @map("launch_date")
  constructionStage String?       @map("construction_stage")
  // Free text, one selling point per line — as typed in the wizard textarea.
  highlights        String?
  salesTeam         String?       @map("sales_team")

  // --- Onboarding-wizard fields (Steps 3-8), added by Piece A. All optional;
  // the wizard wires them progressively in Pieces B-E. `specifications` and
  // `marketing` are deliberately loose preference blobs — their inner shape
  // is expected to evolve, so they're Json rather than columns. ---
  bookingAmount          Int?     @map("booking_amount") // rupees
  currency               String   @default("INR")
  priceIncludes          String[] @default([]) @map("price_includes")
  paymentPlan            String?  @map("payment_plan")
  offers                 String?
  addressLine            String?  @map("address_line")
  city                   String?
  locality               String?
  pincode                String? // kept as text — leading zeros matter
  // No longer collected by the create/edit forms (the map inputs were
  // removed); kept so existing values survive and a future map picker has
  // somewhere to write.
  latitude               Float?
  longitude              Float?
  connectivity           String[] @default([]) // labels copied from the org "connectivity" catalog
  landmarks              String?
  // { items: [{ label, value }], notes }. Older rows hold the original
  // fixed-key shape ({ flooring, kitchen, doorsWindows, fittings, notes });
  // both are read by normalizeSpecifications on the client, so nothing has to
  // be migrated in place.
  specifications         Json?
  marketing              Json? // { adSources, monthlyBudget, targetCpl, leadGoal, landingPageChoice, aiCallingEnabled, whatsappWelcomeEnabled, roundRobinEnabled, aiKnowledgeBaseEnabled }
  requireBookingApproval Boolean  @default(false) @map("require_booking_approval")
  visibleToTelecallers   Boolean  @default(true) @map("visible_to_telecallers")
  publishedToWebsite     Boolean  @default(false) @map("published_to_website")
  coverImageUrl          String?  @map("cover_image_url")
  galleryUrls            String[] @default([]) @map("gallery_urls")
  brochureUrl            String?  @map("brochure_url")
  reraCertificateUrl     String?  @map("rera_certificate_url")
  // Overall project floor / site plans, collected in wizard Step 8. Distinct
  // from UnitType.floorPlanUrl, which is the plan for one configuration and
  // can only exist once unit types are created after publish.
  floorPlanUrls          String[] @default([]) @map("floor_plan_urls")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager      User?               @relation(fields: [managerId], references: [id], onDelete: SetNull)
  unitTypes    UnitType[]
  units        Unit[]
  salesAgents  ProjectSalesAgent[]
  leads        Lead[]
  teams        TeamProject[]
  metaPageConnections MetaPageConnection[]
  marketingConnections MarketingConnection[]

  @@index([orgId])
  @@index([managerId])
  @@index([projectTypeId])
  @@map("projects")
  @@schema("projects")
}

// Sales users assigned to work a project's leads (Step 7 of the wizard).
// Plain many-to-many, same shape as OrganisationTemplate: composite id, both
// sides cascade-delete. Links straight to User — no team concept here.
model ProjectSalesAgent {
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_sales_agents")
  @@schema("projects")
}

// A project's *planned* unit mix, entered in the wizard (Step 2). Since a
// Unit now carries its own configuration/carpet/built-up/price, a UnitType
// no longer owns any Unit — it only records "we plan N of this
// configuration". `name` is a `unit_type` catalog label (same source the
// Unit's `configuration` comes from); the actual per-config counts are
// derived from Unit rows matched by that label. Kept so the project detail
// page can show planned-vs-actual.
model UnitType {
  id          String @id @default(uuid())
  projectId   String @map("project_id")
  name        String
  // Default values to prefill onto a new unit when this configuration is
  // picked, keyed by the project's CURRENT unit-template field keys (see
  // common/utils/field-template.util.ts) — typically at least the `area`- and
  // `price`-role fields. Validated the same way as Unit.customFields
  // (validateCustomValues); a key whose field is later removed from the
  // template is kept, just no longer offered for editing. A snapshot copied
  // onto the unit at pick time, never a live binding.
  fieldDefaults Json  @default("{}") @map("field_defaults")
  // Planned/marketed unit count for this configuration, entered on the form.
  // The *available* count is NOT stored here — it's derived at read time from
  // the actual Unit rows' status so the two can never drift apart.
  totalUnits  Int    @default(0) @map("total_units")

  // Media — nullable, populated by no endpoint. Upload/object-storage is
  // out of scope; these columns exist so the schema is complete and the
  // future upload feature has somewhere to write.
  floorPlanUrl String?  @map("floor_plan_url")
  brochureUrl  String?  @map("brochure_url")
  videoUrl     String?  @map("video_url")
  galleryUrls  String[] @map("gallery_urls")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("unit_types")
  @@schema("projects")
}

model Unit {
  id     String @id @default(uuid())
  // Always set (from the JWT) so every unit — project-bound or standalone —
  // is org-scoped directly, without a join through the project.
  orgId  String @map("org_id")
  // Null for a standalone unit (resale / broker listing with no project).
  projectId String? @map("project_id")
  unitNo String  @map("unit_no") // e.g. "A-301"

  // The unit's configuration — a `unit_type` catalog label ("2 BHK",
  // "Villa"). Validated server-side against the org's catalog on write.
  // Nullable at the DB level for forward-compat / imports; required by the
  // API and the create form.
  configuration String?
  // Optional free-text variant label ("Type A", "Corner"). NOT a catalog,
  // NOT the unit_types table — just a string.
  variantLabel  String? @map("variant_label")

  // Optional — a project whose unit template has no `group`-role field has no
  // grouping. Drives the availability-grid grouping (no unitNo parsing). Free
  // text; not bounded against any project-level count (that was dropped —
  // see Project's comment above).
  tower   String?
  // Set only when the unit template has a `floor`-role field.
  floor   Int?
  // The unit's single area figure — whichever field carries the `area` role
  // (carpet, built-up, plot area, …). In the project's `Project.areaUnit`.
  // Named neutrally so it works for every project type.
  area    Float?
  // Typed values for the project's `unitFieldTemplate`, by field key. Values
  // of fields later removed from the template are kept, just hidden.
  customFields Json @default("{}") @map("custom_fields")
  facing  String? // e.g. "North-East"
  // Free text as entered on the form ("1 covered", "2 covered", "Open").
  parking String?
  price   Int? // rupees

  // Standalone-listing-only fields (null for project units).
  addressLine String? @map("address_line")
  ownerName   String? @map("owner_name")
  notes       String?

  // Media — public R2 URLs from POST /org/projects/upload-url (fields
  // `floorPlan` / `gallery`). Floor plans have no home until the unit
  // exists (project creation defers them here).
  floorPlanUrl String?  @map("floor_plan_url")
  galleryUrls  String[] @default([]) @map("gallery_urls")

  status    UnitStatus @default(available)
  // Access/assignment for a unit, mirroring Project.managerId +
  // Project.salesAgents but at the single-unit level. A project-bound unit
  // normally inherits its access from the project; these mainly matter for a
  // *standalone* unit, which has no project to inherit from. Nullable;
  // ON DELETE SET NULL keeps the unit when the manager is removed.
  managerId String? @map("manager_id")
  // Who created / last touched this unit, from the JWT. Nullable: rows written
  // before these columns existed have no actor, and ON DELETE SET NULL keeps a
  // unit when the user is removed. Complements the audit_logs trail (which
  // records what changed and when) by making "who owns this row now" a cheap
  // join for the list and detail views.
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  organisation Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manager      User?            @relation("UnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("UnitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?            @relation("UnitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  salesAgents  UnitSalesAgent[]

  @@index([orgId])
  @@index([projectId])
  @@index([managerId])
  @@map("units")
  @@schema("projects")
}

// A standalone unit's assigned agents — same shape as ProjectSalesAgent, one
// level down. A project-bound unit is worked by its project's sales team; a
// unit with no project needs its own set.
model UnitSalesAgent {
  unitId     String   @map("unit_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([unitId, userId])
  @@index([userId])
  @@map("unit_sales_agents")
  @@schema("projects")
}

// Org-managed custom catalogs — each organisation builds its own option
// lists for the project onboarding wizard (project types, unit-type labels,
// connectivity/landmark categories, amenities). Not a Super Admin global
// list, not hardcoded in the frontend. Managed from Org Settings;
// pre-created only. One generic table keyed by `category`. "Copy, don't
// reference": when a project is created the picked labels are copied onto
// the project's own columns — there is NO foreign key from a project back
// to a catalog option, so editing/deleting an option never affects an
// already-created project.
// An org's own project-type catalog entry: a name plus two typed field
// templates (JSON arrays of field definitions — see
// common/utils/field-template.util.ts). There is no fixed layout — every
// type is just a list of fields; some carry a `role` (price / area / group /
// floor / configuration) that maps onto a real Unit column and powers a
// feature (availability grid grouping, price per area, …). Which inventory
// controls exist is derived at read time from which roles are present, so
// deleting a role field degrades gracefully instead of erroring. Projects
// COPY the name and templates at creation, so editing or deleting a type
// never touches an existing project. Deliberately not an OrgCatalogOption:
// those are flat labels and cannot carry structure.
model ProjectTypeDef {
  id            String        @id @default(uuid())
  orgId         String        @map("org_id")
  name          String
  // Summary fields on the project ("Number of plots", "Total land"). Never
  // carry a role — roles are a per-UNIT concept.
  projectFields Json          @default("[]") @map("project_fields")
  // Per-unit fields — the template a project's unit form and availability
  // grid render from.
  unitFields    Json          @default("[]") @map("unit_fields")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("project_type_defs")
  @@schema("projects")
}

model OrgCatalogOption {
  id        String             @id @default(uuid())
  orgId     String             @map("org_id")
  category  OrgCatalogCategory
  label     String
  // Manual display order within one (org, category) list; ties broken by label.
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, category, label])
  @@index([orgId, category])
  @@map("org_catalog_options")
  @@schema("projects")
}

// ---------------------------------------------------------------------------
// System Email / SMTP Configuration & Audit Logging
// orgId null = platform (Super Admin). One optional row per organisation.
// ---------------------------------------------------------------------------

model EmailConfig {
  id        String   @id @default(uuid())
  orgId     String?  @unique @map("org_id")
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String   @default("")
  password  String   @default("")
  fromEmail String   @map("from_email")
  fromName  String   @default("iPixxel Realty") @map("from_name")
  replyTo   String?  @map("reply_to")
  isActive  Boolean  @default(true) @map("is_active")

  organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Customizable message templates
  inviteSubject String? @map("invite_subject")
  inviteBody    String? @map("invite_body")
  resetSubject  String? @map("reset_subject")
  resetBody     String? @map("reset_body")
  accountActivatedSubject   String? @map("account_activated_subject")
  accountActivatedBody      String? @map("account_activated_body")
  accountDeactivatedSubject String? @map("account_deactivated_subject")
  accountDeactivatedBody    String? @map("account_deactivated_body")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_configs")
  @@schema("identity")
}

model EmailLog {
  id         String    @id @default(uuid())
  orgId      String?   @map("org_id")
  to         String
  subject    String
  template   String?   // 'invite' | 'password_reset' | 'test' | 'notification' | 'system'
  status     String    // 'sent' | 'failed'
  error      String?
  metadata   Json?
  sentAt     DateTime  @default(now()) @map("sent_at")

  @@index([orgId])
  @@index([to])
  @@index([status])
  @@index([sentAt])
  @@map("email_logs")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Platform subdomain / DNS configuration — single global row (id "platform")
// managed by the Super Admin from the admin console "Org Domains" screen.
// Without this there's no way to point an organisation's <sub>.base subdomain
// at the AWS origin without SSH-ing in to rewrite env vars. The service
// mirrors the EmailConfig pattern: table is auto-created at runtime for
// prod installs where migrations never ran, and on load/update it patches
// process.env so the existing sync domain.utils pick the values up live.
// Environment variables (SUBDOMAIN_BASE_DOMAIN, SUBDOMAIN_MODE, INFRA_IP,
// DNS_MODE, ...) remain as non-DB fallbacks / dev overrides.
// ---------------------------------------------------------------------------

model PlatformConfig {
  id            String   @id @default("platform")
  // localhost | production — production builds "<sub>.base" hosts; localhost
  // dev renders "<sub>.localhost" without needing real DNS.
  subdomainMode String   @default("production") @map("subdomain_mode")
  // The platform's wildcard base domain (e.g. "ipixxel.ae"), no scheme/dots
  // prefix. Organisation subdomains resolve to "<sub>.<this>".
  subdomainBase String?  @map("subdomain_base")
  // a | cname | ns — how the wildcard is pointed at the origin on the
  // DNS provider (default a = A record to the AWS server IP).
  dnsMode String @default("a") @map("dns_mode")
  // Origin target(s) used for the DNS instructions + "verify" checks.
  infraIp    String? @map("infra_ip") // AWS/EC2 IPv4 the server is on
  infraIpv6  String? @map("infra_ipv6")
  infraCname String? @map("infra_cname")
  infraNs1   String? @map("infra_ns1")
  infraNs2   String? @map("infra_ns2")

  // ---------------------------------------------------------------------------
  // Subscription expiry & grace-period policy (Super Admin configurable). All
  // four are read by the expiry sweep (subscription-lifecycle util) when a
  // subscription's term lapses and by the "expiring soon" notification job:
  //   - billingExpiryNotifyDays  how many days BEFORE renewsAt the expiring
  //                              popup notification is raised.
  //   - billingGracePeriodDays   how long a past_due subscription stays usable
  //                              after the term ends before the behaviour below.
  //   - billingExpiryBehavior    what happens once the grace period lapses:
  //                              'restrict' = status switches to `expired` and
  //                              quota-gated actions (publishing, etc.) stop;
  //                              'cancel'    = the subscription is cancelled.
  //   - billingExpiryMessage     the notification body used for the expiring /
  //                              past_due popups (title is derived).
  // ---------------------------------------------------------------------------
  billingExpiryNotifyDays Int     @default(3) @map("billing_expiry_notify_days")
  billingGracePeriodDays  Int     @default(7) @map("billing_grace_period_days")
  billingExpiryBehavior   String  @default("restrict") @map("billing_expiry_behavior") // restrict | cancel
  billingExpiryMessage    String  @default("Your subscription is due for renewal soon. Renew to keep your landing pages and features running without interruption.") @map("billing_expiry_message")
  primaryColor            String  @default("#0f1424") @map("primary_color")
  secondaryColor          String  @default("#2a3348") @map("secondary_color")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("platform_configs")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Media Library — Central media repository for organisations and Super Admin
// ---------------------------------------------------------------------------

model MediaFile {
  id           String   @id @default(uuid())
  orgId        String?  @map("org_id")
  uploadedById String?  @map("uploaded_by_id")
  name         String
  filename     String
  storedKey    String   @map("stored_key")
  publicUrl    String   @map("public_url")
  mimeType     String   @map("mime_type")
  size         Int
  category     String   @default("image") // 'image' | 'video' | 'document' | 'icon' | 'other'
  folder       String   @default("general")
  alt          String?
  tags         String[] @default([])
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation("UploadedMedia", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([category])
  @@index([folder])
  @@index([createdAt])
  @@map("media_files")
  @@schema("identity")
}

