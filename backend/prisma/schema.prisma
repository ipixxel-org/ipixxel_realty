  @@unique([campaignId, externalId])
  @@index([orgId])
  @@map("marketing_ad_sets")
  @@schema("identity")
}

model MarketingAd {
  id          String  @id @default(uuid())
  orgId       String  @map("org_id")
  adSetId     String  @map("ad_set_id")
  externalId  String  @map("external_id")
  name        String
  status      String?
  spend       Decimal @default(0) @db.Decimal(14, 2)
  impressions BigInt  @default(0)
  clicks      BigInt  @default(0)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  adSet MarketingAdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@unique([adSetId, externalId])
  @@index([orgId])
  @@map("marketing_ads")
