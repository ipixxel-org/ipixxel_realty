generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "access", "templates", "audit", "billing", "projects"]
}

// ---------------------------------------------------------------------------
// Enums
// (Enums belong to whichever schema uses them; Prisma requires one
//  @@schema per enum too when multiSchema is on.)
// ---------------------------------------------------------------------------

enum OrgStatus {
  draft
  active
  disabled
  pending
  rejected

  @@schema("identity")
}

enum UserStatus {
  active
  disabled
  // Organisation Admin-provisioned members start here: they cannot log in
  // until the Org Admin approves them (approvedAt is set), and only reach
  // the forced change-password flow until they set their own password, at
  // which point they flip to `active`. Super Admin / Org Admin accounts are
  // never created in this state.
  pending

  @@schema("identity")
}

// Furthest step the signup wizard has *completed* for this user — resume
// logic shows the step after this one. The values below are just the
// allowed set; progression ORDER is defined separately in
// common/utils/onboarding.util.ts's ONBOARDING_STEP_ORDER (not by the
// declaration order here, which isn't relied on anywhere).
enum OnboardingStep {
  account
  organisation
  business_details
  modules
  subscription
  templates
  invite
  connect
  completed

  @@schema("identity")
}

enum RoleScope {
  platform
  organisation
  team

  @@schema("identity")
}

// What kind of real-estate business the org is — collected at Step 2 of the
// signup wizard (previously collected in the UI but discarded, never
// persisted) and editable later from Org Settings → General. Fixed,
// app-controlled list, hence an enum rather than free text.
enum OrgIndustry {
  developer
  broker
  channel
  mixed

  @@schema("identity")
}

// Lookup of organisation kinds (developer, broker, …). Lives in the DB so
// Super Admin / seed can change labels without a code deploy. Organisations
// still store `industry` as OrgIndustry; this table is the display catalog.
model OrgType {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("org_types")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// identity — organisations, users, roles, auth tokens
// (Same idea as QuesPro's "admin" schema — the core identity/account layer)
// ---------------------------------------------------------------------------

model Organisation {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  // Nullable: the wizard creates the Organisation at Step 2 (name +
  // subdomain only) — city is collected later, at Step 3 (Business
  // Details). Every other org-creation path (Super Admin onboarding,
  // old atomic signup) still supplies it upfront.
  city      String?
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")

  // Profile fields — added for the Org Admin settings screen. All nullable
  // except the three with sensible defaults; existing orgs backfill to those.
  timezone        String  @default("Asia/Kolkata")
  currency        String  @default("INR")
  defaultLanguage String  @default("en-IN") @map("default_language")
  logoUrl         String? @map("logo_url")
  faviconUrl      String? @map("favicon_url")
  brandColour     String? @map("brand_colour")
  website         String?
  addressLine1    String? @map("address_line1")
  addressLine2    String? @map("address_line2")
  state           String?
  postalCode      String? @map("postal_code")
  country         String?

  // Business-details step of the signup wizard (Step 3). Both nullable —
  // compliance info a business may not have on day one.
  reraLicenseNo String? @map("rera_license_no")
  gstin         String? @map("gstin")

  // Organisation step of the signup wizard (Step 2) — bucket-style value
  // ("Just me", "2–10", "11–50", "50+"), stored as entered rather than a
  // separate code, matching how it was originally collected.
  teamSize String? @map("team_size")

  // Org Settings → General profile fields. All nullable — most orgs won't
  // have these on day one, and existing rows backfill to null.
  legalName    String?      @map("legal_name")
  industry     OrgIndustry?
  supportEmail String?      @map("support_email")
  supportPhone String?      @map("support_phone")

  // Modules step of the signup wizard (Step 6, skippable) — informational
  // only for now, no enforcement reads this yet (see prompt: out of scope).
  enabledModules String[] @default([]) @map("enabled_modules")

  // The organisation's own site identity, chosen at registration and/or later
  // from the Org Settings → Domain screen. subdomain is the organisation's
  // primary platform address (e.g. skylinedev.ipixxel.ae) and is auto-activated
  // once the Super Admin approves the organisation. A custom domain can be
  // requested (added as a pending OrgDomainRequest) and, once a Super Admin
  // approves, is mapped to the organisation's primary site.
  // Per-website addresses (each template can have its own subdomain or a custom
  // domain) live on LandingPage / DomainRequest instead.
  subdomain          String? @unique
  subdomainStatus    String  @default("pending") @map("subdomain_status") // none | pending | active | rejected
  customDomain       String? @unique @map("custom_domain")
  customDomainStatus String  @default("none") @map("custom_domain_status") // none | pending | approved | connected | rejected
  // The org's PRIMARY landing page that its custom domain serves. When the org
  // requests/connects a custom domain it picks one of its landing pages (its
  // selected template); the approved custom domain is mapped to exactly that
  // page. Defaults to the org's first published page when not explicitly set.
  customDomainLandingPageId String?     @map("custom_domain_landing_page_id")
  customDomainLandingPage   LandingPage? @relation("OrgCustomDomainLandingPage", fields: [customDomainLandingPageId], references: [id], onDelete: SetNull)

  // Set by AdminOrganisationsService.rejectPending when a Super Admin
  // rejects a pending registration — the mandatory reason they entered.
  // Surfaced back in the Super Admin organisations list/detail (an info
  // tooltip next to the "Rejected" status badge) so the decision stays on
  // record. Cleared if the org is later reactivated (see updateStatus).
  rejectionReason String? @map("rejection_reason")

  users                 User[]
  teams                 Team[]
  auditLogs             AuditLog[]
  customRoles           Role[]
  notifications         Notification[]
  subscriptions         Subscription[]
  organisationTemplates OrganisationTemplate[]
  landingPages          LandingPage[]
  typographySets        TypographySet[]
  leadForms             LeadForm[]
  orgDomainRequests     OrgDomainRequest[]
  trackingEvents        TrackingEvent[]
  projects              Project[]
  catalogOptions        OrgCatalogOption[]
  projectTypeDefs       ProjectTypeDef[]
  leadStageDisplays     OrgLeadStageDisplay[]
  units                 Unit[]
  emailConfig           EmailConfig?
  supportTickets        SupportTicket[]
  teamChannels          TeamChannel[]
  teamMessages          TeamMessage[]
  packageChangeRequests PackageChangeRequest[]
  mediaFiles            MediaFile[]
  metaPageConnections   MetaPageConnection[]
  marketingConnections  MarketingConnection[]
  marketingOrgAccess    MarketingOrgPlatformAccess[]

  @@map("organisations")
  @@schema("identity")
}

model User {
  id                  String     @id @default(uuid())
  orgId               String?    @map("org_id")
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  email               String     @unique
  phoneNumber         String?    @map("phone_number")
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(active)
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")

  // Set when an Organisation Admin approves a pending member. Null = still
  // awaiting approval (login denied). Backfilled to created_at for every
  // pre-existing user by the migration, so nobody is locked out.
  approvedAt          DateTime?  @map("approved_at")
  // Any access token whose `iat` predates this instant is rejected by
  // OrgApprovedGuard (fresh per-request check — the only access-token
  // invalidation mechanism). Stamped on disapproval, admin password
  // reset/edit, resend-credentials, and self password change/reset.
  tokenInvalidBefore  DateTime?  @map("token_invalid_before")

  // Signup-wizard resume tracking. Lives on User (not Organisation) for the
  // whole flow, including after the org exists — simplest single source of
  // truth, and avoids a dual-read on login (see common/utils/onboarding.util.ts).
  // Defaults to 'account' since a User row is only ever created once Step 1
  // (Account) has actually completed.
  onboardingStep OnboardingStep @default(account) @map("onboarding_step")
  // Collected at signup Step 1 (Account) — no Organisation exists yet at
  // that point to hold it. Purely for restoring the Country select and
  // stripping the dial code back off the phone number on resume (see
  // AuthService.resumeSignup / stripCallingCode on the frontend); the
  // Organisation's own `country` (set at Step 2) is the source of truth
  // once an org exists.
  country String? @map("country")
  emailVerifiedAt DateTime? @map("email_verified_at")
  // Terms of Service & Privacy Policy acceptance — checked at signup Step 2
  // (Organisation). Set once, never cleared; this is a compliance record,
  // not a live "currently agreed" flag.
  termsAcceptedAt DateTime? @map("terms_accepted_at")

  organisation    Organisation?          @relation(fields: [orgId], references: [id])
  userRoles       UserRole[]
  userPermissions UserModulePermission[]
  teamMembers     TeamMember[]
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs       AuditLog[]
  managedProjects Project[]
  salesProjects   ProjectSalesAgent[]
  ledTeams        Team[]
  assignedLeads   Lead[]
  callLogs        CallLog[]
  activityEvents  ActivityEvent[]
  notifications   Notification[]
  createdUnits    Unit[]                 @relation("UnitCreatedBy")
  updatedUnits    Unit[]                 @relation("UnitUpdatedBy")
  uploadedMedia   MediaFile[]            @relation("UploadedMedia")
  managedUnits    Unit[]                 @relation("UnitManager")
  unitSalesAgentAssignments UnitSalesAgent[]
  raisedSupportTickets SupportTicket[]   @relation("SupportTicketRaisedBy")
  closedSupportTickets SupportTicket[]   @relation("SupportTicketClosedBy")
  heldSupportTickets   SupportTicket[]   @relation("SupportTicketHeldBy")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignedTo")
  sentSupportMessages  SupportMessage[]  @relation("SupportMessageSender")
  teamChannelsCreated  TeamChannel[]     @relation("TeamChannelCreatedBy")
  teamChannelsDm       TeamChannel[]     @relation("TeamChannelDmUser")
  teamChannelMembers   TeamChannelMember[]
  sentTeamMessages     TeamMessage[]     @relation("TeamMessageSender")
  packageChangeRequests PackageChangeRequest[] @relation("PackageChangeRequestedBy")
  packageChangeReviews  PackageChangeRequest[] @relation("PackageChangeReviewedBy")

  @@map("users")
  @@schema("identity")
}

model Role {
  id        String    @id @default(uuid())
  key       String    // super_admin / admin / manager / sales / telecaller / custom
  name      String
  scope     RoleScope
  // Null = platform-wide system/default role (visible to every org).
  // Set   = a custom role created by a specific org's Admin, visible only
  //         within that org.
  orgId     String?   @map("org_id")
  // A role can be soft-disabled so it can no longer be newly assigned to org
  // users (existing memberships keep working). System roles can be disabled
  // too but never deleted.
  status    RoleStatus @default(active)
  description String?  @default("")
  sortOrder Int       @default(0) @map("sort_order")

  organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  permissions RoleModulePermission[]

  // A role key only needs to be unique within its scope: once globally
  // (orgId IS NULL) and once per-org (orgId, key) for custom roles.
  @@unique([orgId, key])
  @@map("roles")
  @@schema("identity")
}

enum RoleStatus {
  active
  inactive

  @@schema("identity")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("identity")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@schema("identity")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// access — teams, membership, and the two-layer permission model
// ---------------------------------------------------------------------------

enum TeamStatus {
  active
  inactive

  @@schema("access")
}

model Team {
  id           String     @id @default(uuid())
  orgId        String     @map("org_id")
  name         String
  status       TeamStatus @default(active)
  // FK to an org user (verified server-side to belong to the caller's org,
  // same rule as Project.managerId). Null = no lead assigned; SetNull so
  // deleting the lead's user account never deletes the team.
  teamLeadId   String?    @map("team_lead_id")
  region       String?
  workingHours String?    @map("working_hours")
  description  String?    @default("")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamLead     User?              @relation(fields: [teamLeadId], references: [id], onDelete: SetNull)
  members      TeamMember[]
  moduleAccess TeamModuleAccess[]
  projects     TeamProject[]
  channels     TeamChannel[]

  @@index([orgId])
  @@index([teamLeadId])
  @@map("teams")
  @@schema("access")
}

// Per-member seniority/position label shown on the team roster and
// onboarding page (Team Lead / Sr. Agent / Sales Agent / Telecaller /
// Viewer). Deliberately its own enum with zero relation to the org-wide
// `Role`/RBAC system (see RoleModulePermission/UserModulePermission) — the
// "telecaller" value exists independently in both namespaces by coincidence
// only; never map or compare across them in code.
enum TeamMemberRole {
  team_lead
  sr_agent
  sales_agent
  telecaller
  viewer

  @@schema("access")
}

model TeamMember {
  teamId   String         @map("team_id")
  userId   String         @map("user_id")
  role     TeamMemberRole @default(sales_agent)
  joinedAt DateTime       @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
  @@schema("access")
}

// A team's assigned projects — a plain many-to-many with Project, replaced
// wholesale on write (PUT), exactly mirroring ProjectSalesAgent's shape and
// cascade behaviour.
model TeamProject {
  teamId     String   @map("team_id")
  projectId  String   @map("project_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([teamId, projectId])
  @@index([projectId])
  @@map("team_projects")
  @@schema("access")
}

// Layer 1 — which modules are in scope for a team at all
model TeamModuleAccess {
  teamId    String  @map("team_id")
  moduleKey String  @map("module_key")
  isEnabled Boolean @default(true) @map("is_enabled")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, moduleKey])
  @@map("team_module_access")
  @@schema("access")
}

// Layer 2 — what a role can do within a module, once it's in scope for the team.
//
// org-scoped: the org admin configures each assignable role's page/action
// access for THEIR organisation only (orgId + roleId). The roles themselves
// are a global catalogue, but the permissions an org grants each role are
// per-org — so editing "manager" in org A never touches org B. The org-wide
// `admin` role and the platform `super_admin` role are never restricted here
// (they always has every permission).
model RoleModulePermission {
  orgId      String  @map("org_id")
  roleId     String  @map("role_id")
  moduleKey  String  @map("module_key")
  canView    Boolean @default(true) @map("can_view")
  canAdd     Boolean @default(false) @map("can_add")
  canEdit    Boolean @default(false) @map("can_edit")
  canDelete  Boolean @default(false) @map("can_delete")
  canApprove Boolean @default(false) @map("can_approve") // e.g. approving a landing-page publish
  canActivate   Boolean @default(false) @map("can_activate") // Users module: activate / approve a member
  canDeactivate Boolean @default(false) @map("can_deactivate") // Users module: deactivate / disapprove a member
  canAddLead    Boolean @default(false) @map("can_add_lead") // Projects module: Add lead from a project

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([orgId, roleId, moduleKey])
  @@index([orgId, roleId])
  @@map("role_module_permissions")
  @@schema("access")
}

// Per-user page/action overrides — an org admin can grant a SPECIFIC user or
// sales agent different access than their role grants by default. Keyed to
// (orgId, userId, moduleKey); null/absent means "inherit from the role".
// Actions are stored on single columns (like RoleModulePermission) with null
// meaning "not overridden" — falling back to the user's role permission.
model UserModulePermission {
  orgId      String   @map("org_id")
  userId     String   @map("user_id")
  moduleKey  String   @map("module_key")
  canView    Boolean? @map("can_view")
  canAdd     Boolean? @map("can_add")
  canEdit    Boolean? @map("can_edit")
  canDelete  Boolean? @map("can_delete")
  canApprove Boolean? @map("can_approve")
  canActivate   Boolean? @map("can_activate")
  canDeactivate Boolean? @map("can_deactivate")
  canAddLead    Boolean? @map("can_add_lead")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, moduleKey])
  @@index([orgId, userId])
  @@map("user_module_permissions")
  @@schema("access")
}

// ---------------------------------------------------------------------------
// Team Chat — internal chat for each team (channels + direct messages). Plain
// REST + the frontend polls, no websockets — same call/response model as
// Support tickets. A channel is either a team channel (`kind` = 'channel',
// optionally linked to a Team row so its members auto-join) or a two-person
// DM (`kind` = 'dm', `name` = the other user). Tagging a Lead attaches its id
// to a message so the UI can render a "shared lead" card; `assignedTo` is a
// free-text label ("Rohit", "NRI Desk") copied at send time so later renames
// never rewrite chat history.
// ---------------------------------------------------------------------------

model TeamChannel {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  kind        String   @default("channel") // channel | dm
  name        String
  // channel → the Team it was created from (nullable for ad-hoc channels);
  // dm      → always null.
  teamId      String?  @map("team_id")
  // dm → the *other* participant (never the creator). Null for channels.
  dmUserId    String?  @map("dm_user_id")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organisation Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("TeamChannelCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  dmUser       User?            @relation("TeamChannelDmUser", fields: [dmUserId], references: [id], onDelete: SetNull)
  members      TeamChannelMember[]
  messages     TeamMessage[]

  @@index([orgId])
  @@index([teamId])
  @@map("team_channels")
  @@schema("access")
}

// Membership for a channel plus the per-user last-read marker. `lastReadAt`
// null = the user has never opened the channel yet (every message counts as
// unread until they do). Opening a channel (GET detail) stamps it to now.
model TeamChannelMember {
  channelId  String    @map("channel_id")
  userId     String    @map("user_id")
  lastReadAt DateTime? @map("last_read_at")
  joinedAt   DateTime  @default(now()) @map("joined_at")

  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("team_channel_members")
  @@schema("access")
}

model TeamMessage {
  id         String   @id @default(uuid())
  channelId  String   @map("channel_id")
  orgId      String   @map("org_id")
  senderId   String   @map("sender_id")
  body       String
  // Tagged lead card — links the tagged Lead row.
  leadId     String?  @map("lead_id")
  // Free-text "assigned to" label ("Rohit", "NRI Desk", "this channel").
  assignedTo String?  @map("assigned_to")
  createdAt  DateTime @default(now()) @map("created_at")

  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User        @relation("TeamMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  lead    Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([orgId])
  @@map("team_messages")
  @@schema("access")
}

// ---------------------------------------------------------------------------
// audit — logging, kept separate the same way QuesPro isolates "audit"
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id")
  actorId   String?  @map("actor_id")
  moduleKey String?  @map("module_key")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [orgId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Notifications — in-app alerts surfaced to a recipient (typically a Super
// Admin) when something needs attention, e.g. an organisation registration or
// a domain/subdomain request waiting for approval. Email delivery stays
// stubbed via console.log (matching the rest of the codebase); this row is the
// durable, queryable "notification" the UI reads for the bell / approvals.
// ---------------------------------------------------------------------------

enum NotificationType {
  organisation_registration
  subdomain_request
  custom_domain_request
  organisation_approved
  organisation_rejected
  // Support ticket lifecycle — support_ticket_created / _message fan out to
  // "all super admins" (recipientId null, same as the org-registration rows
  // above); support_ticket_status_changed is addressed to the org member who
  // raised the ticket. See SupportService.
  support_ticket_created
  support_ticket_message
  support_ticket_status_changed
  // A Super Admin assigns a ticket to a specific Platform Team member —
  // addressed to that member only (recipientId), not the "all super admins"
  // broadcast. See SupportService.assignTicket.
  support_ticket_assigned
  // Subscription lifecycle — created by the expiry sweep (and the org's own
  // billing read when the sweep hasn't run yet). subscription_expiring fires
  // `notifyDays` before renewsAt; subscription_past_due fires the moment the
  // term ends and the grace period begins; subscription_expired fires once the
  // grace period lapses without a renewal (or the subscription is cancelled by
  // the configured post-grace behaviour).
  subscription_expiring
  subscription_past_due
  subscription_expired
  package_change_request
  package_change_approved
  package_change_rejected

  @@schema("audit")
}

model Notification {
  id          String           @id @default(uuid())
  orgId       String?          @map("org_id")
  recipientId String?          @map("recipient_id") // user id; null = all super admins (cosmetic grouping)
  type        NotificationType
  title       String
  body        String?
  entity      String? // e.g. "Organisation" | "OrgDomainRequest" | "SupportTicket"
  entityId    String?          @map("entity_id")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [orgId], references: [id])
  recipient    User?         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([type])
  @@map("notifications")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Support tickets — an org member raises an issue to the Platform Team and
// the two sides chat in a threaded conversation (SupportMessage). Status
// starts `open`, moves to `ongoing` once either side has replied, and only
// becomes `resolved` when a Super Admin closes the ticket — the org side
// never sets `resolved` directly. Plain REST + polling, no websockets.
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  open
  ongoing
  on_hold
  resolved

  @@schema("audit")
}

enum SupportTicketPriority {
  normal
  high
  urgent

  @@schema("audit")
}

model SupportTicket {
  id         String                @id @default(uuid())
  // Human-friendly per-org ticket number ("SR-1", "SR-2", …) — count of the
  // org's existing tickets + 1 at creation time (see SupportService.create),
  // not a global sequence, so it reads naturally regardless of how many
  // other orgs are on the platform.
  number     Int
  orgId      String                @map("org_id")
  raisedById String                @map("raised_by_id")
  subject    String
  category   String
  priority   SupportTicketPriority @default(normal)
  status     SupportTicketStatus   @default(open)
  closedAt   DateTime?             @map("closed_at")
  closedById String?               @map("closed_by_id")
  // Set together whenever a Super Admin puts this ticket on hold (see
  // SupportService.holdTicket) — holdReason is what the tooltip in both the
  // org and Support Management lists shows. Left in place across a later
  // resume/close so the last hold reason stays visible as a record; only
  // `status` gates whether it's currently shown.
  holdReason String?               @map("hold_reason")
  heldAt     DateTime?             @map("held_at")
  heldById   String?               @map("held_by_id")
  // Set only by a Super Admin (see SupportService.assignTicket) — the
  // Platform Team member this ticket is handed off to. A non-super-admin
  // Platform Team member with Support Management access only ever sees (and
  // can act on) tickets where this is their own id (see
  // SupportService.assertAdminTicketAccess).
  assignedToId String?             @map("assigned_to_id")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  organisation Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  raisedBy     User             @relation("SupportTicketRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  closedBy     User?            @relation("SupportTicketClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  heldBy       User?            @relation("SupportTicketHeldBy", fields: [heldById], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@unique([orgId, number])
  @@index([orgId])
  @@index([status])
  @@index([assignedToId])
  @@map("support_tickets")
  @@schema("audit")
}

// One chat message in a ticket's thread. `senderId` is always a User row —
// an org member (their own org's ticket) or a Platform Team member (any
// ticket) — so "which side sent this" is derived from sender.orgId at read
// time rather than a stored flag.
model SupportMessage {
  id             String   @id @default(uuid())
  ticketId       String   @map("ticket_id")
  senderId       String   @map("sender_id")
  body           String
  attachmentUrls String[] @default([]) @map("attachment_urls")
  createdAt      DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// templates — Super Admin landing-page template library (builder content
// lives in `content`, stored as-is; the frontend owns the shape of that JSON)
// ---------------------------------------------------------------------------

enum TemplateStatus {
  draft
  published
  scheduled
  password
  unpublished

  @@schema("templates")
}

enum TemplateKind {
  preset
  custom

  @@schema("templates")
}

enum TemplatePageType {
  landing
  thank_you

  @@schema("templates")
}

enum TemplateTier {
  free
  paid
  premium

  @@schema("templates")
}

model TemplateCategory {
  id        String       @id @default(uuid())
  name      String       @unique
  slug      String       @unique
  tier      TemplateTier @default(free)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  templates Template[]

  @@map("template_categories")
  @@schema("templates")
}

model Template {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  status         TemplateStatus   @default(draft)
  tier           TemplateTier     @default(free)
  thumbnail      String?
  designId       String           @map("design_id")
  baseDesignName String           @map("base_design_name")
  categoryId     String?          @map("category_id")
  kind           TemplateKind     @default(custom)
  pageType       TemplatePageType @default(landing) @map("page_type")
  parentId       String?          @map("parent_id")
  domain         String           @default("")
  content        Json
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  parent                Template?              @relation("TemplatePages", fields: [parentId], references: [id], onDelete: SetNull)
  childPages            Template[]             @relation("TemplatePages")
  templateCategory      TemplateCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  organisationTemplates OrganisationTemplate[]
  landingPages          LandingPage[]
  pageRevisions         PageRevision[]

  @@map("templates")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// billing — plans & subscriptions
// ---------------------------------------------------------------------------

enum BillingCycle {
  monthly
  yearly

  @@schema("billing")
}

enum SubscriptionStatus {
  active
  past_due
  trial
  cancelled
  paused
  // Set when the subscription's grace period ends without renewal and the
  // platform's configured expiry behaviour is 'restrict'. Publishing and
  // other quota-gated actions are blocked until the org renews.
  expired

  @@schema("billing")
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?  @default("")
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly")
  // Marketing bullet strings only — not functional. Not the source of truth
  // for anything.
  features     Json     @default("[]")
  // Numeric quotas: { projects, users, templates }, each `number | null`
  // (null = unlimited).
  limits       Json?
  // Boolean capability flags from the plan-capabilities catalog:
  // { <catalogKey>: boolean }. A missing key means false.
  capabilities Json     @default("{}")
  color        String   @default("#eef0fe")
  badge        String   @default("b-indigo")
  isPopular    Boolean  @default(false) @map("is_popular")
  isActive     Boolean  @default(true) @map("is_active")
  // The platform's default onboarding plan (seeded "Basic") — editable like
  // any other plan, but AdminPlansService.remove() refuses to delete it so
  // every-new-org auto-assignment (see onboarding-finalize.util.ts) always
  // has a target. Never set via the API; only by seed. Deliberately not a
  // slug check — renaming the plan in the admin UI must not silently drop
  // the protection.
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  currentPlanRequests PackageChangeRequest[] @relation("CurrentPlanRequests")
  targetPlanRequests  PackageChangeRequest[] @relation("TargetPlanRequests")

  @@map("plans")
  @@schema("billing")
}

model Subscription {
  id           String             @id @default(uuid())
  orgId        String             @map("org_id")
  planId       String             @map("plan_id")
  billingCycle BillingCycle       @default(monthly) @map("billing_cycle")
  status       SubscriptionStatus @default(active)
  amount       Int
  currency     String             @default("INR")
  renewsAt     DateTime?          @map("renews_at")
  // End of the platform-configurable grace period once the term has lapsed.
  // Set on the active/trial -> past_due transition and cleared on renewal.
  // When the sweep runs after this datetime and the status is still past_due,
  // the configured expiry behaviour is applied (see lifetime.utils).
  graceEndsAt  DateTime?          @map("grace_ends_at")
  mrr          Int? // monthly recurring normalized value
  startedAt    DateTime           @default(now()) @map("started_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
  @@schema("billing")
}

enum PackageChangeRequestStatus {
  pending
  approved
  rejected
  cancelled

  @@schema("billing")
}

model PackageChangeRequest {
  id              String                     @id @default(uuid())
  orgId           String                     @map("org_id")
  requestedById   String                     @map("requested_by_id")
  currentPlanId   String                     @map("current_plan_id")
  targetPlanId    String                     @map("target_plan_id")
  billingCycle    BillingCycle               @default(monthly) @map("billing_cycle")
  status          PackageChangeRequestStatus @default(pending)
  rejectionReason String?                    @map("rejection_reason")
  reviewedAt      DateTime?                  @map("reviewed_at")
  reviewedById    String?                    @map("reviewed_by_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("PackageChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("PackageChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  currentPlan  Plan         @relation("CurrentPlanRequests", fields: [currentPlanId], references: [id], onDelete: Restrict)
  targetPlan   Plan         @relation("TargetPlanRequests", fields: [targetPlanId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([status])
  @@map("package_change_requests")
  @@schema("billing")
}


model OrganisationTemplate {
  orgId      String   @map("org_id")
  templateId String   @map("template_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([orgId, templateId])
  @@index([templateId])
  @@map("organisation_templates")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Org-owned landing pages — an org's own independent, editable copy made by
// "using" an assigned Template. The Template row is never mutated by this;
// see LandingPagesService for the copy-on-use guarantee.
// ---------------------------------------------------------------------------

enum LandingPageStatus {
  draft
  pending_approval
  approved
  rejected
  published
  unpublished

  @@schema("templates")
}

model LandingPage {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  teamId           String?           @map("team_id") // nullable — reserved for later team-level delegation, unused for now
  sourceTemplateId String?           @map("source_template_id")
  name             String
  slug             String
  status           LandingPageStatus @default(draft)
  content          Json // { sections, config } — the org's own copy
  thumbnail        String?
  pageType         TemplatePageType  @default(landing) @map("page_type")
  parentId         String?           @map("parent_id") // thank-you companion linkage, among the org's own pages
  submittedAt      DateTime?         @map("submitted_at")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewedById     String?           @map("reviewed_by_id")
  rejectionReason  String?           @map("rejection_reason")
  publishedAt      DateTime?         @map("published_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organisation    Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceTemplate  Template?       @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  parent          LandingPage?    @relation("LandingPageCompanion", fields: [parentId], references: [id], onDelete: SetNull)
  children        LandingPage[]   @relation("LandingPageCompanion")
  customDomainOrgs Organisation[] @relation("OrgCustomDomainLandingPage")
  orgDomainRequests OrgDomainRequest[]
  trackingEvents  TrackingEvent[]
  pageRevisions   PageRevision[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([status])
  @@map("landing_pages")
  @@schema("templates")
}

// Builder version history — one row per content-changing save, capped at 30
// per page (pruned oldest-first on capture). Stores the full content JSON so
// the Version History panel can restore it; deliberately separate from
// AuditLog, whose metadata rows carry no payload. Exactly one of
// landingPageId/templateId is set. `orgId` is denormalised for cheap
// org-scoped queries and for platform templates (null).
model PageRevision {
  id            String   @id @default(uuid())
  landingPageId String?  @map("landing_page_id")
  templateId    String?  @map("template_id")
  orgId         String?  @map("org_id")
  content       Json // { sections, config, engine, site } — snapshot as saved
  label         String   @default("")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  landingPage LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  template    Template?    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([landingPageId, createdAt])
  @@index([templateId, createdAt])
  @@map("page_revisions")
  @@schema("templates")
}

model TypographySet {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id") // null = platform-wide set (Super Admin owned)
  name      String
  tokens    Json // the design-system token payload (TemplateTypography), stored as-is
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // NOTE: Postgres never treats two NULLs as equal for uniqueness, so this
  // does NOT stop two platform sets (orgId: null) from sharing a name — it
  // only blocks duplicate names within one real org. Accepted deliberately:
  // platform sets are Super-Admin-only, a single trusted role that can just
  // not do that, and a real DB-level fix needs a partial unique index
  // (WHERE org_id IS NULL) outside what this schema DSL can express.
  @@unique([orgId, name])
  @@map("typography_sets")
  @@schema("templates")
}

// Lead capture forms — the org-scoped Form Builder library. orgId null =
// platform-wide form owned by the Super Admin; org forms are strictly
// per-organisation. The definition is stored whole (the FormDefinition JSON
// the FormDesigner edits) so the frontend round-trips it unchanged; `name`
// is a denormalised copy for cheap listing.
model LeadForm {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id")
  name      String
  content   Json // { id, embed, fields, ... } — the form definition as-is
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([updatedAt])
  @@map("lead_forms")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Template-isolated website stack — Organisation → Template → Pages → Domain
// → DNS → SSL → Tracking → SEO → Publishing. Every LandingPage is an
// independent website instance (see prompt §1, §30).
// ---------------------------------------------------------------------------

enum OrgDomainRequestKind {
  subdomain
  custom_domain

  @@schema("templates")
}

enum OrgDomainRequestStatus {
  pending
  approved
  rejected
  connected

  @@schema("templates")
}

// A Super-Admin-reviewed request to claim the organisation's own site address:
// a platform subdomain (kind = "subdomain") or a custom domain (kind =
// "custom_domain"). These are the rows the Super Admin "Org Domains" screen
// lists and approves/rejects across all organisations. Approval writes the
// ground truth onto Organisation:
//   - subdomain     -> Organisation.subdomain + subdomainStatus = active
//   - custom_domain -> Organisation.customDomain + customDomainStatus = connected,
//                      mapped to the org's selected landing page
//                      (Organisation.customDomainLandingPageId).
model OrgDomainRequest {
  id              String                 @id @default(uuid())
  orgId           String                 @map("org_id")
  kind            OrgDomainRequestKind
  subdomain       String?
  customDomain    String?                @map("custom_domain")
  // For custom_domain requests: the org's chosen landing page (template) that
  // the custom domain should serve. Optional — defaults to the org's first
  // published page at approval time.
  landingPageId   String?                @map("landing_page_id")
  status          OrgDomainRequestStatus @default(pending)
  requestedBy     String?                @map("requested_by")
  requestedAt     DateTime               @default(now()) @map("requested_at")
  reviewedAt      DateTime?              @map("reviewed_at")
  reviewedBy      String?                @map("reviewed_by")
  rejectionReason String?                @map("rejection_reason")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organisation Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  landingPage  LandingPage?  @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([status])
  @@map("org_domain_requests")
  @@schema("templates")
}

model TrackingEvent {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  landingPageId String   @map("landing_page_id")
  eventType     String   @map("event_type")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([landingPageId])
  @@index([eventType])
  @@map("tracking_events")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Leads — captured from the builder's lead forms (public site + previews).
// orgId is a plain scalar (no Relation field) so we don't have to thread a
// back-relation onto Organisation/LandingPage; the landingPageId is kept for
// filtering/grouping only.
// ---------------------------------------------------------------------------

model Lead {
  id             String     @id @default(uuid())
  orgId          String     @map("org_id")
  landingPageId  String?    @map("landing_page_id")
  projectId      String?    @map("project_id")
  formName       String?    @map("form_name")
  source         String?    @default("website") // website | popup | floorplan | preview | project-widget
  data           Json
  status         LeadStatus @default(new)
  assignedToId   String?    @map("assigned_to_id")
  nextActionType String?    @map("next_action_type")
  nextActionAt   DateTime?  @map("next_action_at")
  nextActionNote String?    @map("next_action_note")
  reminderAt     DateTime?  @map("reminder_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  // --- CRM edit-form fields ---------------------------------------------------
  // Structured columns edited on the lead edit page. All additive, nullable /
  // defaulted — the public capture path still writes only `data` (the raw form
  // blob); these are populated by agents via PATCH /org/leads/:id. Kept as real
  // columns (not JSON) so they stay filterable/reportable, matching how the
  // nextAction* / reminderAt fields already sit here.
  altName          String?  @map("alt_name")
  altPhone         String?  @map("alt_phone")
  whatsapp         String?
  city             String?
  budgetMin        BigInt?  @map("budget_min")
  budgetMax        BigInt?  @map("budget_max")
  configurations   String[] @default([]) @map("configurations")
  purpose          String?
  financing        String?
  loanStatus       String?  @map("loan_status")
  timelineToBuy    String?  @map("timeline_to_buy")
  preferredFloor   String?  @map("preferred_floor")
  facing           String?
  parking          String?
  requirementNotes String?  @map("requirement_notes")
  campaign         String?
  // Marketing channel medium (e.g. Paid Social) — distinct from utmMedium.
  medium           String?
  campaignId       String?  @map("campaign_id")
  adSet            String?  @map("ad_set")
  adSetId          String?  @map("ad_set_id")
  ad               String?
  adId             String?  @map("ad_id")
  utmSource        String?  @map("utm_source")
  utmMedium        String?  @map("utm_medium")
  utmCampaign      String?  @map("utm_campaign")
  utmTerm          String?  @map("utm_term")
  utmContent       String?  @map("utm_content")
  landingPageUrl   String?  @map("landing_page_url")
  fbclid           String?
  gclid            String?
  // Marketing platform key (meta, google_ads, website, …) for Lead Center Source.
  platform         String?
  referrer         String?
  landingPage      String?  @map("landing_page")
  firstTouchSource String?  @map("first_touch_source")
  lastTouchSource  String?  @map("last_touch_source")
  // Meta Lead Ads identity — used for idempotent webhook ingest.
  metaLeadgenId    String?  @unique @map("meta_leadgen_id")
  metaFormId       String?  @map("meta_form_id")
  metaPageId       String?  @map("meta_page_id")
  temperature      String?
  tags             String[] @default([]) @map("tags")
  consentWhatsapp  Boolean  @default(false) @map("consent_whatsapp")
  consentCall      Boolean  @default(false) @map("consent_call")
  consentEmail     Boolean  @default(false) @map("consent_email")

  assignedTo User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  callLogs   CallLog[]
  activities ActivityEvent[]
  teamMessages TeamMessage[]

  @@index([orgId])
  @@index([landingPageId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@index([utmSource])
  @@index([campaignId])
  @@index([platform])
  @@map("leads")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Platform-level attribution / tracking labels. Super Admin enables or
// disables each key; enabled labels surface in org Lead Center and on new
// lead capture. Keys are stable (source, medium, campaign, …); `label` is
// the display name orgs see (Organisation Labels).
// ---------------------------------------------------------------------------

model PlatformAttributionLabel {
  id        String   @id @default(uuid())
  // Stable machine key — matches Lead column / capture field names.
  key       String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("platform_attribution_labels")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Facebook / Instagram Lead Ads — org-connected Pages. Platform Meta App
// credentials live in env (META_APP_ID / META_APP_SECRET); each org OAuth-
// connects one or more Pages whose leadgen webhooks create CRM leads.
// ---------------------------------------------------------------------------

model MetaPageConnection {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  pageId       String   @map("page_id")
  pageName     String   @map("page_name")
  // Long-lived Page access token (never returned raw to the client).
  accessToken  String   @map("access_token")
  // Optional default project for leads from this Page.
  projectId    String?  @map("project_id")
  connectedBy  String?  @map("connected_by")
  connectedAt  DateTime @default(now()) @map("connected_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([orgId, pageId])
  @@index([pageId])
  @@index([orgId])
  @@map("meta_page_connections")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// Marketing Integration Hub — platform-agnostic connections, synced campaign
// hierarchy, metrics, and sync logs. Campaign creation stays on the official
// platforms; we only sync and attribute.
// ---------------------------------------------------------------------------

model MarketingPlatform {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  enabled     Boolean  @default(true)
  // Whether orgs may attempt OAuth (false = website-only / stub).
  supportsOAuth   Boolean @default(false) @map("supports_oauth")
  supportsWebhook Boolean @default(false) @map("supports_webhook")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  connections MarketingConnection[]
  orgAccess   MarketingOrgPlatformAccess[]

  @@index([enabled])
  @@map("marketing_platforms")
  @@schema("identity")
}

model MarketingOrgPlatformAccess {
